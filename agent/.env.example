# Required: LiveKit Cloud project (cloud.livekit.io -> Settings -> API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: swap the LLM to River
# LLM_PROVIDER=river
# RIVER_BASE_URL=
# RIVER_API_KEY=
# RIVER_MODEL=

# Optional: swap TTS to Gradium (your cloned voice)
# TTS_PROVIDER=gradium
# GRADIUM_API_KEY=
# GRADIUM_VOICE_ID=

# Phone GPS pings (location_server.py); any random string, also used in the phone app URL
# LOCATION_TOKEN=
# DEMO_CONTACTS_JSON={"+14155550123": "Dana Lee"}
# RIVER_TOOLS_TOKEN=
# OUTBOUND_CALLS_ENABLED=0
# LATE_THRESHOLD_MIN=5

# Vapi (phone agent)
# VAPI_API_KEY=
# VAPI_PUBLIC_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_PHONE_NUMBER_ID=
# VAPI_OUTBOUND_PHONE_NUMBER_ID=
# VOICE_BRIDGE_URL=https://<your-tunnel>/vapi/tts
# VAPI_LLM=openai            # or river
# FISH_API_KEY=
# FISH_VOICE_ID=

# Who the agent speaks as, and where UFO's drafts land
# SPEAKER_NAME=
# SPEAKER_EMAIL=
